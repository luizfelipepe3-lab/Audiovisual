<body>

<header><div class="header-inner"><div class="institution-brand"><img width="200" height="42" alt="UniCesumar" src="data:image/svg+xml;base64,"></div><div class="heading-title"><h1>DEPARTAMENTO DE OPERAÇÕES</h1><h2>CONTROLE DE TELEVISÕES</h2><p>Tecnologia a serviço da educação</p></div><div class="header-tools"><div class="header-clock"><span id="dataPainel"></span><strong id="horaPainel"></strong></div><button type="button" id="btnConfiguracoes" class="settings-trigger" title="Configurações" aria-label="Abrir configurações" aria-haspopup="dialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m9 3-.6 2.4-2 .9L4 5.6 2 9l1.8 1.7v2.6L2 15l2 3.4 2.4-.7 2 .9L9 21h4l.6-2.4 2-.9 2.4.7 2-3.4-1.8-1.7v-2.6L20 9l-2-3.4-2.4.7-2-.9L13 3Z"/><circle cx="11" cy="12" r="3"/></svg></button></div></div></header>


<dialog id="configDialog" class="config-dialog" aria-labelledby="configTitle">
 <div class="config-top"><h2 id="configTitle">Configurações</h2><button type="button" id="fecharConfig" aria-label="Fechar configurações">×</button></div>
 <section class="config-account"><h3>Minha conta</h3>    <div class="barra-usuario">
      <span id="usuarioLogado"></span>

      <button class="sair" id="btnSair">
        SAIR
      </button>
    </div></section>
 <section class="config-devices"><h3>Gerenciar TVs</h3><button id="btnAdicionarTV" class="adicionar-tv" type="button">＋ Adicionar TV</button>
 <button type="button" id="btnAbrirAgendaConfig" class="agenda-option">Agenda das TVs</button>
 <div id="configAgendaTV" class="config-agenda-select" hidden>
  <label for="tvParaAgenda">Selecione a TV</label>
  <select id="tvParaAgenda"><option value="">Selecione uma TV</option></select>
  <button type="button" id="btnGerenciarAgendaTV">Gerenciar agenda da TV</button>
 </div>
 <button type="button" id="btnAbrirExclusao" class="delete-option">Excluir TV</button>
 <form id="formExcluirTV" hidden>
  <label for="tvParaExcluir">Selecione a TV</label>
  <select id="tvParaExcluir" required><option value="">Selecione uma TV</option></select>
  <p class="delete-help">Remove a TV do painel. Se o Raspberry voltar a publicar o mesmo ID, ela continuará oculta neste painel até ser cadastrada novamente. Não desliga a televisão.</p>
  <button type="submit" id="btnConfirmarExclusao" class="delete-confirm">Excluir TV selecionada</button>
 </form>
