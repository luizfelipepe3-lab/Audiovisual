        </div>

        <div class="campo">
          <label for="senha">Senha</label>
          <input
            type="password"
            id="senha"
            autocomplete="current-password"
            required
          >
        </div>

        <button class="entrar" type="submit">
          ENTRAR
        </button>

      </form>

      <div id="erroLogin">
        E-mail ou senha inválidos.
      </div>

    </div>
  </div>


  <div id="painel">







    <div class="resumo-tvs">
      <div class="resumo-card"><div class="resumo-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="3" width="20" height="14" rx="1"/><path d="M8 22h8m-4-5v5"/></svg></div><div><strong id="totalTVs">0</strong><span>Total de TVs</span></div></div>
      <div class="resumo-card"><div class="resumo-icone online"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="3" width="20" height="14" rx="1"/><path d="M8 22h8m-4-5v5"/></svg></div><div><strong id="totalOnline">0</strong><span>Online</span><small id="pctOnline">0%</small></div></div>
      <div class="resumo-card"><div class="resumo-icone offline"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="3" width="20" height="14" rx="1"/><path d="M8 22h8m-4-5v5"/></svg></div><div><strong id="totalOffline">0</strong><span>Offline</span><small id="pctOffline">0%</small></div></div>
    </div>

    <div class="ferramentas">
      <input id="buscaTV" aria-label="Buscar TV por nome ou local" type="search" placeholder="Buscar TV por nome ou local...">
      <select id="filtroLocal" aria-label="Filtrar por local"><option value="">Todos os locais</option></select><div class="view-actions"><button type="button" id="modoGrade" aria-label="Visualização em grade" aria-pressed="true">▦</button><button type="button" id="modoLista" aria-label="Visualização em lista" aria-pressed="false">☷</button></div>
    </div>

    <div id="listaTVs"></div>

    <div class="titulo">

      



    </div>
    <div id="semTVs">
      Nenhuma TV cadastrada.
    </div>

  </div>

</main>

<div id="modalAdicionarTV" class="modal-overlay" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="tituloModalTV">
    <h3 id="tituloModalTV">Cadastrar nova TV</h3>
    <p>O ID deve ser exatamente o mesmo que será informado no Raspberry.</p>
    <form id="formAdicionarTV">
      <div class="campo">
        <label for="novoTvId">Nome / ID da TV</label>
        <input type="text" id="novoTvId" placeholder="Ex.: Auditório de Medicina" maxlength="120" required>
      </div>
      <div class="campo">
        <label for="novoTvLocal">Local</label>
        <input type="text" id="novoTvLocal" placeholder="Ex.: Bloco 8 - Auditório" maxlength="120">
      </div>
      <div id="mensagemCadastro"></div>
      <div class="modal-acoes">
        <button id="btnCancelarCadastro" class="cancelar" type="button">CANCELAR</button>
        <button id="btnConfirmarCadastro" class="cadastrar" type="submit">CADASTRAR</button>
      </div>
    </form>
  </div>
</div>



<div id="modalAgenda" class="modal-overlay" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="tituloAgenda">
    <h3 id="tituloAgenda">Agenda da TV</h3>
    <p id="agendaTvNome"></p>
    <div class="agenda-default">A automação só funciona quando esta TV possui pelo menos uma agenda cadastrada.</div>
    <div id="listaAgendas" class="agenda-lista"></div>
    <form id="formAgenda" class="agenda-form">
      <div class="agenda-form-grid">
        <div><label for="agendaTipo">Tipo</label><select id="agendaTipo"><option value="unico">Dia único</option><option value="semanal">Semanal</option><option value="mensal">Mensal</option></select></div>
        <div><label for="agendaNome">Nome da agenda</label><input id="agendaNome" maxlength="60" placeholder="Ex.: Sábado de evento"></div>
        <div id="campoData"><label for="agendaData">Data</label><input id="agendaData" type="date"></div>
        <div id="campoDiaMes" hidden><label for="agendaDiaMes">Dia do mês</label><input id="agendaDiaMes" type="number" min="1" max="31" value="1"></div>
        <div><label for="agendaInicio">Ligar às</label><input id="agendaInicio" type="time" required></div>
        <div><label for="agendaFim">Desligar às</label><input id="agendaFim" type="time" required></div>
      </div>
      <div id="campoDiasSemana" hidden><label>Dias da semana</label><div class="dias-semana">
        <label><input type="checkbox" value="1">Seg</label><label><input type="checkbox" value="2">Ter</label><label><input type="checkbox" value="3">Qua</label><label><input type="checkbox" value="4">Qui</label><label><input type="checkbox" value="5">Sex</label><label><input type="checkbox" value="6">Sáb</label><label><input type="checkbox" value="0">Dom</label>
      </div></div>
      <div class="modal-acoes"><button id="btnFecharAgenda" class="cancelar" type="button">FECHAR</button><button class="cadastrar" type="submit">ADICIONAR AGENDA</button></div>
      <div id="msgAgenda" class="agenda-status"></div>
    </form>
  </div>
</div>

<footer>
  UniCesumar &nbsp; | &nbsp; Departamento de Operações <span class="versao">Visual 3.3</span>
</footer>


<script type="module">

  import {
    initializeApp
  }
  from "https://www.gstatic.com/firebasejs/12.3.0/firebase-app.js";


  import {
    getAuth,
    signInWithEmailAndPassword,
    signOut,
    onAuthStateChanged
  }
  from "https://www.gstatic.com/firebasejs/12.3.0/firebase-auth.js";


  import {
    getFirestore,
    collection,
    doc,
    onSnapshot,
    updateDoc,
    setDoc,
    deleteDoc
  }
  from "https://www.gstatic.com/firebasejs/12.3.0/firebase-firestore.js";


  const firebaseConfig = {
    apiKey: "AIzaSyBKkE6ztjFxPxRSiaUP1awnUlTmnONTgz0",
    authDomain: "controle-tvs-61fd0.firebaseapp.com",
    projectId: "controle-tvs-61fd0",
    storageBucket: "controle-tvs-61fd0.firebasestorage.app",
    messagingSenderId: "631526398818",
    appId: "1:631526398818:web:9d6fb6b507ef759ab32a3b"
  };


  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const tvsRef = collection(db, "tvs");


  const loginArea =
    document.getElementById("loginArea");

  const painel =
    document.getElementById("painel");

  const loginForm =
    document.getElementById("loginForm");

  const erroLogin =
    document.getElementById("erroLogin");

  const usuarioLogado =
    document.getElementById("usuarioLogado");

  const btnSair =
    document.getElementById("btnSair");

  const listaTVs =
    document.getElementById("listaTVs");

  const semTVs =
    document.getElementById("semTVs");

  const btnAdicionarTV = document.getElementById("btnAdicionarTV");
  const modalAdicionarTV = document.getElementById("modalAdicionarTV");
  const formAdicionarTV = document.getElementById("formAdicionarTV");
  const novoTvId = document.getElementById("novoTvId");
  const novoTvLocal = document.getElementById("novoTvLocal");
  const mensagemCadastro = document.getElementById("mensagemCadastro");
  const btnCancelarCadastro = document.getElementById("btnCancelarCadastro");
  const btnConfirmarCadastro = document.getElementById("btnConfirmarCadastro");
  const totalTVs = document.getElementById("totalTVs");
  const totalOnline = document.getElementById("totalOnline");
  const totalOffline = document.getElementById("totalOffline");
  const buscaTV = document.getElementById("buscaTV");


  let pararMonitor = null;
  let intervaloTela = null;

  let primeiraLeitura = true;

  let dadosTVs = new Map();

  let estadosAnteriores = new Map();

  let desligamentosSolicitados = new Set();
  let tvAgendaAtual = null;
  const comandosAgendaRecentes = new Map();
  const TVsOcultas = new Set(JSON.parse(localStorage.getItem("tvsOcultas") || "[]"));



  // ==========================================
  // CONFIGURACOES
  // ==========================================

  const TEMPO_OFFLINE = 15 * 60 * 1000;

  // ==========================================
  // LOGIN
  // ==========================================

  loginForm.addEventListener(
    "submit",
    async (event) => {

      event.preventDefault();

      erroLogin.style.display =
        "none";

      const email =
        document.getElementById("email").value;

      const senha =
        document.getElementById("senha").value;

      try {

        await signInWithEmailAndPassword(
          auth,
          email,
          senha
        );

        document.getElementById("senha").value =
          "";

      }

      catch (erro) {

        console.error(erro);

        erroLogin.style.display =
          "block";

      }

    }
  );


  btnSair.addEventListener(
    "click",
    async () => {

      await signOut(auth);

    }
  );


  // ==========================================
  // CADASTRAR NOVA TV
  // ==========================================

  function abrirCadastroTV() {
    formAdicionarTV.reset();
    mensagemCadastro.textContent = "";
    mensagemCadastro.style.color = "#6b7280";
    btnConfirmarCadastro.disabled = false;
    modalAdicionarTV.classList.add("aberto");
    modalAdicionarTV.setAttribute("aria-hidden", "false");
    setTimeout(() => novoTvId.focus(), 50);
  }

  function fecharCadastroTV() {
    modalAdicionarTV.classList.remove("aberto");
    modalAdicionarTV.setAttribute("aria-hidden", "true");
    formAdicionarTV.reset();
    mensagemCadastro.textContent = "";
    btnConfirmarCadastro.disabled = false;
  }

  btnAdicionarTV.addEventListener("click", abrirCadastroTV);
  btnCancelarCadastro.addEventListener("click", fecharCadastroTV);

  modalAdicionarTV.addEventListener("click", (event) => {
    if (event.target === modalAdicionarTV) fecharCadastroTV();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modalAdicionarTV.classList.contains("aberto")) {
      fecharCadastroTV();
    }
  });

  formAdicionarTV.addEventListener("submit", async (event) => {
    event.preventDefault();

    const tvId = novoTvId.value.trim();
    const local = novoTvLocal.value.trim();

    if (!tvId) {
      mensagemCadastro.textContent = "Informe o nome / ID da TV.";
      mensagemCadastro.style.color = "#dc2626";
      return;
    }

    if (tvId.includes("/")) {
      mensagemCadastro.textContent = 'O ID da TV não pode conter o caractere "/".';
      mensagemCadastro.style.color = "#dc2626";
      return;
    }

    if (dadosTVs.has(tvId)) {
      mensagemCadastro.textContent = "Já existe uma TV cadastrada com esse ID.";
      mensagemCadastro.style.color = "#dc2626";
      return;
    }

    try {
      btnConfirmarCadastro.disabled = true;
      mensagemCadastro.textContent = "Cadastrando TV...";
      mensagemCadastro.style.color = "#6b7280";

      const novaTvRef = doc(db, "tvs", tvId);
      TVsOcultas.delete(tvId);
      localStorage.setItem("tvsOcultas", JSON.stringify([...TVsOcultas]));

      TVsOcultas.delete(tvId);
      localStorage.setItem("tvsOcultas", JSON.stringify([...TVsOcultas]));

      await setDoc(novaTvRef, {
        excluido: false,
        nome: tvId,
        local: local || "Local não informado",
        comando: "nenhum",
        estado: "desconhecido",
        online: false,
        ultimaAtualizacao: null
      });

      mensagemCadastro.textContent = "TV cadastrada com sucesso!";
      mensagemCadastro.style.color = "#166534";
      setTimeout(fecharCadastroTV, 900);
    } catch (erro) {
      console.error("Erro ao cadastrar TV:", erro);
      mensagemCadastro.textContent = "Erro ao cadastrar. Verifique as permissões do Firestore.";
      mensagemCadastro.style.color = "#dc2626";
      btnConfirmarCadastro.disabled = false;
    }
  });


  // ==========================================
  // ENVIAR COMANDO
  // ==========================================

  async function enviarComando(
    tvId,
    comando,
    mensagemElemento
  ) {

    try {

      mensagemElemento.textContent =
        "Enviando comando...";


      if (comando === "desligar") {

        desligamentosSolicitados.add(
          tvId
        );

      }


      const tvRef =
        doc(
          db,
          "tvs",
          tvId
        );


      await updateDoc(
        tvRef,
        {
          comando: comando
        }
      );


      mensagemElemento.textContent =
        "Comando enviado. Aguardando a TV...";

    }

    catch (erro) {

      console.error(erro);


      if (comando === "desligar") {

        desligamentosSolicitados.delete(
          tvId
        );

      }


      mensagemElemento.textContent =
        "Erro ao enviar o comando.";

    }

  }


  // ==========================================
  // ONLINE / OFFLINE
  // ==========================================

  function verificarOnline(dados) {

    if (!dados.ultimaAtualizacao) {
      return false;
    }

    try {

      const ultima =
        dados.ultimaAtualizacao.toDate();

      const diferenca =
        Date.now() -
        ultima.getTime();

      return (
        diferenca <=
        TEMPO_OFFLINE
      );

    }

    catch (erro) {

      return false;

    }

  }


  function textoUltimaComunicacao(dados) {

    if (!dados.ultimaAtualizacao) {

      return "Última comunicação desconhecida";

    }

    try {

      const data =
        dados.ultimaAtualizacao.toDate();

      return (
        "Última comunicação: " +
        data.toLocaleTimeString(
          "pt-BR",
          {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
          }
        )
      );

    }

    catch (erro) {

      return "Última comunicação desconhecida";

    }

  }


  // ==========================================
  // AGENDA DE FUNCIONAMENTO
  // ==========================================
  function minutos(hora) { const [h,m] = String(hora||"00:00").split(":").map(Number); return h*60+m; }
  function agendasDaTV(dados) { return Array.isArray(dados.agendas) ? dados.agendas : []; }
  function agendaValeHoje(a, agora=new Date()) {
    if (a.tipo === "unico") return a.data === `${agora.getFullYear()}-${String(agora.getMonth()+1).padStart(2,"0")}-${String(agora.getDate()).padStart(2,"0")}`;
    if (a.tipo === "mensal") return Number(a.diaMes) === agora.getDate();
    return Array.isArray(a.dias) && a.dias.map(Number).includes(agora.getDay());
  }
  function deveEstarLigada(dados, agora=new Date()) {
    const atual=minutos(`${String(agora.getHours()).padStart(2,"0")}:${String(agora.getMinutes()).padStart(2,"0")}`);
    return agendasDaTV(dados).some(a => agendaValeHoje(a,agora) && atual >= minutos(a.inicio) && atual < minutos(a.fim));
  }
  function proximaDescricao(dados) {
    return deveEstarLigada(dados) ? "Agenda ativa agora — deve permanecer LIGADA" : "Fora do horário programado — deve permanecer DESLIGADA";
  }
  async function aplicarAgendaTV(tvId,dados) {
    if (!verificarOnline(dados)) return;
    // Sem agenda cadastrada, o painel não interfere no estado da TV.
    if (!agendasDaTV(dados).length) return;
    const comando=String(dados.comando||"nenhum").toLowerCase();
    if (comando === "ligar" || comando === "desligar") return;
    const estado=String(dados.estado||"desconhecido").toLowerCase();
    const desejado=deveEstarLigada(dados)?"ligada":"desligada";
    if (estado !== "ligada" && estado !== "desligada") return;
    if (estado === desejado) return;
    const chave=tvId+":"+desejado, ultimo=comandosAgendaRecentes.get(chave)||0;
    if (Date.now()-ultimo < 60000) return;
    comandosAgendaRecentes.set(chave,Date.now());
    const ref=doc(db,"tvs",tvId);
    try { await updateDoc(ref,{comando:desejado === "ligada" ? "ligar" : "desligar"}); }
    catch(e){ console.error("Erro na agenda automática",tvId,e); }
  }
  function aplicarTodasAgendas(){ dadosTVs.forEach((dados,id)=>aplicarAgendaTV(id,dados)); }

  const modalAgenda=document.getElementById("modalAgenda"), formAgenda=document.getElementById("formAgenda"), agendaTipo=document.getElementById("agendaTipo"), listaAgendas=document.getElementById("listaAgendas"), msgAgenda=document.getElementById("msgAgenda");
  function atualizarCamposAgenda(){ const t=agendaTipo.value; document.getElementById("campoData").hidden=t!=="unico"; document.getElementById("campoDiasSemana").hidden=t!=="semanal"; document.getElementById("campoDiaMes").hidden=t!=="mensal"; }
  agendaTipo.addEventListener("change",atualizarCamposAgenda); atualizarCamposAgenda();
  function descricaoAgenda(a){ if(a.tipo==="unico") return `${a.data} • ${a.inicio}–${a.fim}`; if(a.tipo==="mensal") return `Todo dia ${a.diaMes} • ${a.inicio}–${a.fim}`; const nomes=["Dom","Seg","Ter","Qua","Qui","Sex","Sáb"]; return `${(a.dias||[]).map(d=>nomes[Number(d)]).join(", ")} • ${a.inicio}–${a.fim}`; }
  function renderAgendas(){
    listaAgendas.innerHTML=""; const dados=dadosTVs.get(tvAgendaAtual); if(!dados)return;
    const personalizadas=Array.isArray(dados.agendas)?dados.agendas:[];
    if(!personalizadas.length){ listaAgendas.innerHTML='<div class="agenda-item"><strong>Sem agenda cadastrada</strong><p>Esta TV não será ligada ou desligada automaticamente.</p></div>'; return; }
    personalizadas.forEach(a=>{ const item=document.createElement("div"); item.className="agenda-item"; const top=document.createElement("div"); top.className="agenda-item-top"; const tx=document.createElement("div"); tx.innerHTML=`<strong>${a.nome||"Agenda"}</strong><p>${descricaoAgenda(a)}</p>`; const del=document.createElement("button"); del.type="button"; del.textContent="EXCLUIR"; del.onclick=async()=>{ const novas=personalizadas.filter(x=>x.id!==a.id); await updateDoc(doc(db,"tvs",tvAgendaAtual),{agendas:novas}); dados.agendas=novas; renderAgendas(); }; top.append(tx,del); item.append(top); listaAgendas.append(item); });
  }
  function abrirAgenda(tvId){ tvAgendaAtual=tvId; const d=dadosTVs.get(tvId); document.getElementById("agendaTvNome").textContent=(d?.nome||tvId)+" — "+(d?.local||""); msgAgenda.textContent=""; renderAgendas(); modalAgenda.classList.add("aberto"); modalAgenda.setAttribute("aria-hidden","false"); }
  function fecharAgenda(){ modalAgenda.classList.remove("aberto"); modalAgenda.setAttribute("aria-hidden","true"); tvAgendaAtual=null; formAgenda.reset(); atualizarCamposAgenda(); }
  document.getElementById("btnFecharAgenda").addEventListener("click",fecharAgenda); modalAgenda.addEventListener("click",e=>{if(e.target===modalAgenda)fecharAgenda();});
  formAgenda.addEventListener("submit",async e=>{ e.preventDefault(); if(!tvAgendaAtual)return; const tipo=agendaTipo.value,inicio=document.getElementById("agendaInicio").value,fim=document.getElementById("agendaFim").value; if(minutos(fim)<=minutos(inicio)){msgAgenda.textContent="O horário de desligar precisa ser depois do horário de ligar.";return;} const a={id:"ag-"+Date.now()+"-"+Math.random().toString(36).slice(2,7),tipo,nome:document.getElementById("agendaNome").value.trim()||"Agenda",inicio,fim}; if(tipo==="unico"){a.data=document.getElementById("agendaData").value;if(!a.data){msgAgenda.textContent="Selecione a data.";return;}} if(tipo==="mensal")a.diaMes=Number(document.getElementById("agendaDiaMes").value); if(tipo==="semanal"){a.dias=[...document.querySelectorAll('#campoDiasSemana input:checked')].map(x=>Number(x.value));if(!a.dias.length){msgAgenda.textContent="Selecione pelo menos um dia da semana.";return;}} const d=dadosTVs.get(tvAgendaAtual),novas=[...(Array.isArray(d.agendas)?d.agendas:[]),a]; try{await updateDoc(doc(db,"tvs",tvAgendaAtual),{agendas:novas});d.agendas=novas;msgAgenda.textContent="Agenda adicionada.";renderAgendas();formAgenda.reset();atualizarCamposAgenda();}catch(err){console.error(err);msgAgenda.textContent="Não foi possível salvar a agenda. Verifique as permissões do Firestore.";} });

  // ==========================================
  // CRIAR CARD
  // ==========================================

  function criarCardTV(
    tvId,
    dados
  ) {

    const online =
      verificarOnline(dados);


    const card =
      document.createElement("div");

    card.className =
      "tv-card";

    card.dataset.busca =
      (dados.nome || tvId) + " " + (dados.local || "");


    if (!online) {

      card.classList.add(
        "offline"
      );

    }


    const topo =
      document.createElement("div");

    topo.className =
      "tv-topo";


    const info =
      document.createElement("div");

    info.className =
      "tv-nome";


    const nome =
      document.createElement("h3");

    nome.textContent =
      dados.nome || tvId;


    const local =
      document.createElement("p");

    local.textContent =
      dados.local ||
      "Local não informado";


    info.appendChild(nome);
    info.appendChild(local);


    const status =
      document.createElement("div");

    status.className =
      "status";


    const comando =
      String(
        dados.comando ||
        "nenhum"
      )
      .trim()
      .toLowerCase();


    const estado =
      String(
        dados.estado ||
        "desconhecido"
      )
      .trim()
      .toLowerCase();


    if (!online) {

      status.textContent =
        "DESCONHECIDO";

      status.classList.add(
        "desconhecido"
      );

    }

    else if (
      comando === "ligar"
    ) {

      status.textContent =
        "Ligando...";

      status.classList.add(
        "processando"
      );

    }

    else if (
      comando === "desligar"
    ) {

      status.textContent =
        "Desligando...";

      status.classList.add(
        "processando"
      );

    }

    else if (
      estado === "ligada"
    ) {

      status.textContent =
        "LIGADA";

      status.classList.add(
        "ligada"
      );

    }

    else if (
      estado === "desligada"
    ) {

      status.textContent =
        "DESLIGADA";

      status.classList.add(
        "desligada"
      );

    }

    else if (
      estado === "ligando" ||
      estado === "desligando"
    ) {

      status.textContent =
        estado === "ligando"
        ? "Ligando..."
        : "Desligando...";

      status.classList.add(
        "processando"
      );

    }

    else {

      status.textContent =
        "Estado desconhecido";

      status.classList.add(
        "desconhecido"
      );

    }


    topo.appendChild(info);
    topo.appendChild(status);


    // STATUS DO RASPBERRY

    const conexao =
      document.createElement("div");


    if (online) {

      conexao.className =
        "conexao online";

      conexao.innerHTML =
        "● Raspberry ONLINE";

    }

    else {

      conexao.className =
        "conexao offline";

      conexao.innerHTML =
        "● Raspberry OFFLINE";

    }


    const ultima =
      document.createElement("span");

    ultima.className =
      "ultima-comunicacao";

    ultima.textContent =
      textoUltimaComunicacao(
        dados
      );


    conexao.appendChild(
      ultima
    );


    // BOTOES

    const botoes =
      document.createElement("div");

    botoes.className =
      "botoes";


    const btnLigar =
      document.createElement("button");

    btnLigar.className =
      "ligar";

    btnLigar.textContent =
      "LIGAR";


    const btnDesligar =
      document.createElement("button");

    btnDesligar.className =
      "desligar";

    btnDesligar.textContent =
      "DESLIGAR";


    const processando =
      comando === "ligar" ||
      comando === "desligar";


    btnLigar.disabled =
      processando ||
      !online;

    btnDesligar.disabled =
      processando ||
      !online;


    const mensagem =
      document.createElement("div");

    mensagem.className =
      "mensagem";


    if (!online) {

      mensagem.textContent =
        "Sem comunicação com o Raspberry.";

    }


    btnLigar.addEventListener(
      "click",
      () => {

        btnLigar.disabled =
          true;

        btnDesligar.disabled =
          true;

        enviarComando(
          tvId,
          "ligar",
          mensagem
        );

      }
    );


    btnDesligar.addEventListener(
      "click",
      () => {

        btnLigar.disabled =
          true;

        btnDesligar.disabled =
          true;

        enviarComando(
          tvId,
          "desligar",
          mensagem
        );

      }
    );


    botoes.appendChild(
      btnLigar
    );

    botoes.appendChild(
      btnDesligar
    );


    card.appendChild(
      topo
    );

    card.appendChild(
      conexao
    );

    card.appendChild(
      botoes
    );

    card.appendChild(
      mensagem
    );


    return card;

  }


  function atualizarResumo() {
    const tvs = Array.from(dadosTVs.values());
    const quantidadeOnline = tvs.filter((dados) => verificarOnline(dados)).length;
    totalTVs.textContent = tvs.length;
    totalOnline.textContent = quantidadeOnline;
    totalOffline.textContent = tvs.length - quantidadeOnline;
  }

  function aplicarBusca() {
    const termo = (buscaTV.value || "").trim().toLowerCase();
    document.querySelectorAll(".tv-card").forEach((card) => {
      const texto = (card.dataset.busca || "").toLowerCase();
      card.style.display = (!termo || texto.includes(termo)) ? "" : "none";
    });
  }

  buscaTV.addEventListener("input", aplicarBusca);

  // ==========================================
  // DESENHAR PAINEL
  // ==========================================

  function desenharPainel() {

    listaTVs.innerHTML =
      "";


    atualizarResumo();

    if (
      dadosTVs.size === 0
    ) {

      semTVs.style.display =
        "block";

      return;

    }


    semTVs.style.display =
      "none";


    // Ordena as TVs por bloco/local em ordem crescente.
    // "numeric: true" faz Bloco 2 aparecer antes de Bloco 10.
    // Dentro do mesmo bloco/local, ordena pelo nome da TV.
    const tvsOrdenadas = [...dadosTVs.entries()].sort(
      ([idA, dadosA], [idB, dadosB]) => {
        const localA = String(dadosA.local || "").trim();
        const localB = String(dadosB.local || "").trim();

        const porLocal = localA.localeCompare(
          localB,
          "pt-BR",
          { numeric: true, sensitivity: "base" }
        );

        if (porLocal !== 0) return porLocal;

        const nomeA = String(dadosA.nome || idA).trim();
        const nomeB = String(dadosB.nome || idB).trim();

        return nomeA.localeCompare(
          nomeB,
          "pt-BR",
          { numeric: true, sensitivity: "base" }
        );
      }
    );

    tvsOrdenadas.forEach(
      ([tvId, dados]) => {
        const card = criarCardTV(tvId, dados);
        listaTVs.appendChild(card);
      }
    );

    aplicarBusca();

    if (primeiraLeitura) {

      dadosTVs.forEach(
        (dados, tvId) => {

          estadosAnteriores.set(
            tvId,
            {
              estado:
                String(
                  dados.estado ||
                  "desconhecido"
                )
                .trim()
                .toLowerCase(),

              online:
                verificarOnline(
                  dados
                )
            }
          );

        }
      );


      primeiraLeitura =
        false;

    }

  }


  // ==========================================
  // FIRESTORE
  // ==========================================

  function iniciarMonitor() {

    if (pararMonitor) {
      pararMonitor();
    }


    primeiraLeitura =
      true;

    dadosTVs.clear();

    estadosAnteriores.clear();

    desligamentosSolicitados.clear();


    pararMonitor =
      onSnapshot(

        tvsRef,

        (snapshot) => {

          dadosTVs.clear();


          snapshot.forEach(
            (documento) => {

              const dados = documento.data();
              // TVs removidas permanecem ocultas mesmo que o Raspberry recrie/atualize o documento.
              if (dados.excluido === true || TVsOcultas.has(documento.id)) return;
              dadosTVs.set(documento.id, dados);

            }
          );


          desenharPainel();

        },


        (erro) => {

          console.error(erro);

          listaTVs.innerHTML =
            "<p>Erro ao carregar as TVs.</p>";

        }

      );


    if (intervaloTela) {

      clearInterval(
        intervaloTela
      );

    }


    intervaloTela =
      setInterval(
        () => {

          desenharPainel();

        },
        5000
      );

  }


  // ==========================================
  // AUTENTICACAO
  // ==========================================

  onAuthStateChanged(
    auth,
    (usuario) => {

      if (usuario) {

        loginArea.style.display =
          "none";

        painel.style.display =
          "block";


        usuarioLogado.textContent =
          "Conectado como: " +
          usuario.email;


        iniciarMonitor();

      }

      else {

        if (pararMonitor) {

          pararMonitor();

          pararMonitor =
            null;

        }


        if (intervaloTela) {

          clearInterval(
            intervaloTela
          );

          intervaloTela =
            null;

        }


        dadosTVs.clear();

        estadosAnteriores.clear();

        desligamentosSolicitados.clear();


        listaTVs.innerHTML =
          "";


        painel.style.display =
          "none";

        loginArea.style.display =
          "block";

        usuarioLogado.textContent =
          "";

      }

    }
  );


  // Configurações e exclusão de cadastro.
  const configDialog = document.getElementById('configDialog');
  const settingsButton = document.getElementById('btnConfiguracoes');
  const deleteForm = document.getElementById('formExcluirTV');
  const deleteSelect = document.getElementById('tvParaExcluir');
  const deleteButton = document.getElementById('btnConfirmarExclusao');
  const configMessage = document.getElementById('msgConfig');
  const configAgendaBox = document.getElementById('configAgendaTV');
  const agendaConfigSelect = document.getElementById('tvParaAgenda');
  let deletingTV = false;
  function preencherTVsAgendaConfig() {
    agendaConfigSelect.replaceChildren(new Option('Selecione uma TV', ''));
    [...dadosTVs.entries()].sort((a,b) => String(a[1].nome || a[0]).localeCompare(String(b[1].nome || b[0]), 'pt-BR')).forEach(([id,data]) => {
      agendaConfigSelect.add(new Option((data.nome || id) + (data.local ? ' — ' + data.local : ''), id));
    });
  }
  function preencherTVsExclusao() {
    deleteSelect.replaceChildren(new Option('Selecione uma TV', ''));
    [...dadosTVs.entries()].sort((a,b) => String(a[1].nome || a[0]).localeCompare(String(b[1].nome || b[0]), 'pt-BR')).forEach(([id, data]) => {
      deleteSelect.add(new Option((data.nome || id) + (data.local ? ' — ' + data.local : ''), id));
    });
    deleteButton.disabled = !dadosTVs.size;
  }
  settingsButton.addEventListener('click', () => {
    if (!auth.currentUser) return;
    deleteForm.hidden = true;
    configAgendaBox.hidden = true;
    configMessage.textContent = '';
    configDialog.showModal();
  });
  document.getElementById('fecharConfig').addEventListener('click', () => { if (!deletingTV) configDialog.close(); });
  configDialog.addEventListener('click', event => {
    const box = configDialog.getBoundingClientRect();
    if (event.target === configDialog && (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) && !deletingTV) configDialog.close();
  });
  configDialog.addEventListener('cancel', event => { if (deletingTV) event.preventDefault(); });
  configDialog.addEventListener('close', () => { if (auth.currentUser) settingsButton.focus(); });
  btnAdicionarTV.addEventListener('click', () => {
    configDialog.close();
    setTimeout(() => novoTvId.focus(), 60);
  });
  btnSair.addEventListener('click', () => configDialog.close());
  document.getElementById('btnAbrirAgendaConfig').addEventListener('click', () => {
    if (deletingTV) return;
    deleteForm.hidden = true;
    preencherTVsAgendaConfig();
    configAgendaBox.hidden = false;
    configMessage.textContent = dadosTVs.size ? '' : 'Nenhuma TV cadastrada.';
    agendaConfigSelect.focus();
  });
  document.getElementById('btnGerenciarAgendaTV').addEventListener('click', () => {
    const id = agendaConfigSelect.value;
    if (!id || !dadosTVs.has(id)) { configMessage.textContent = 'Selecione uma TV para gerenciar a agenda.'; return; }
    configDialog.close();
    abrirAgenda(id);
  });
  document.getElementById('btnAbrirExclusao').addEventListener('click', () => {
    configAgendaBox.hidden = true;
    if (deletingTV) return;
    preencherTVsExclusao();
    deleteForm.hidden = false;
    configMessage.textContent = dadosTVs.size ? '' : 'Nenhuma TV cadastrada para excluir.';
    deleteSelect.focus();
  });
  deleteForm.addEventListener('submit', async event => {
    event.preventDefault();
    if (deletingTV || !auth.currentUser) return;
    const id = deleteSelect.value;
    if (!id || !dadosTVs.has(id)) {
      configMessage.textContent = 'Selecione uma TV cadastrada.';
      return;
    }
    const name = dadosTVs.get(id).nome || id;
    if (!window.confirm('Retirar "' + name + '" do painel? O cadastro será removido do painel. A TV não será desligada.')) return;
    deletingTV = true;
    deleteButton.disabled = true;
    deleteSelect.disabled = true;
    configMessage.textContent = 'Excluindo TV...';
    try {
      // Guarda uma marca local persistente: se o Raspberry recriar o documento,
      // ele continua fora do painel até ser cadastrado novamente manualmente.
      TVsOcultas.add(id);
      localStorage.setItem('tvsOcultas', JSON.stringify([...TVsOcultas]));
      try {
        await deleteDoc(doc(db, 'tvs', id));
      } catch (deleteError) {
        console.warn('Exclusão física não permitida; usando marca de exclusão.', deleteError);
        await updateDoc(doc(db, 'tvs', id), { excluido: true });
      }
      dadosTVs.delete(id);
      estadosAnteriores.delete(id);
      desligamentosSolicitados.delete(id);
      desenharPainel();
      preencherTVsExclusao();
      configMessage.textContent = 'TV "' + name + '" retirada do painel. Para reativar, cadastre novamente com o mesmo ID.';
    } catch (error) {
      console.error('Erro ao excluir TV:', error);
      TVsOcultas.delete(id);
      localStorage.setItem('tvsOcultas', JSON.stringify([...TVsOcultas]));
      configMessage.textContent = error.code === 'permission-denied'
        ? 'O Firestore recusou a alteração (permission-denied). A TV não foi excluída. É necessário revisar as regras de acesso.'
        : 'Não foi possível retirar a TV: ' + (error.code || 'erro de conexão') + '. O cadastro foi mantido.';
    } finally {
      deletingTV = false;
      deleteSelect.disabled = false;
      deleteButton.disabled = !dadosTVs.size;
    }
  });
  onAuthStateChanged(auth, user => { if (!user && configDialog.open) configDialog.close(); });

</script>

<script>
// Controles de apresentação; comandos e conexão permanecem no módulo original.
(()=>{
 const byId=id=>document.getElementById(id),list=byId('listaTVs'),filter=byId('filtroLocal');
 const clock=()=>{const d=new Date();byId('dataPainel').textContent=d.toLocaleDateString('pt-BR',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});byId('horaPainel').textContent=d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});};clock();setInterval(clock,30000);
 const apply=()=>{const term=byId('buscaTV').value.trim().toLowerCase();list.querySelectorAll('.tv-card').forEach(c=>{const local=c.querySelector('.tv-nome p')?.textContent||'';c.style.display=(!term||(c.dataset.busca||'').toLowerCase().includes(term))&&(!filter.value||local===filter.value)?'':'none';});};
 const refresh=()=>{const previous=filter.value;const places=[...new Set([...list.querySelectorAll('.tv-nome p')].map(e=>e.textContent))].sort((a,b)=>a.localeCompare(b,'pt-BR'));filter.replaceChildren(new Option('Todos os locais',''),...places.map(x=>new Option(x,x)));filter.value=places.includes(previous)?previous:'';const total=Number(byId('totalTVs').textContent);for(const [id,count] of [['pctOnline','totalOnline'],['pctOffline','totalOffline']])byId(id).textContent=(total?Math.round(Number(byId(count).textContent)/total*100):0)+'%';apply();};
 new MutationObserver(refresh).observe(list,{childList:true});filter.addEventListener('change',apply);byId('buscaTV').addEventListener('input',()=>queueMicrotask(apply));
 for(const [id,isList] of [['modoGrade',false],['modoLista',true]])byId(id).addEventListener('click',()=>{list.classList.toggle('em-lista',isList);byId('modoLista').setAttribute('aria-pressed',String(isList));byId('modoGrade').setAttribute('aria-pressed',String(!isList));});
})();
</script>
